{
  "name": "my-nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "prisma generate && next build",
    "git-push": "git add . && git commit -m \"auto commit\" && git push origin main",
    "git": "next build && npm run git-push",
    "pull": "git pull origin main",
    "git-all": "powershell -Command \"$confirm = Read-Host 'Are you sure to push to all branches? (y/n)'; if ($confirm -eq 'y') { next build; git add .; git commit -m 'auto commit'; git push origin main; git push origin HEAD:claude/repo-capabilities-access-wkpcqz }\"",
    "prisma-migrate": "npx prisma migrate dev --name auto",
    "prisma-generate": "npx prisma generate",
    "prisma-sync": "npx tsx app/framework/lib/scripts/generateTypes.ts",
    "prisma": "npm run prisma-migrate && npm run prisma-generate && npm run prisma-sync",
    "docker": "docker compose down && docker compose up --build -d",
    "docker-dev": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up --build",
    "docker-k6": "docker run --rm -v \"%cd%/load-tests:/scripts\" grafana/k6 run /scripts/script.js",
    "k6": "k6 run load-tests/script.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "restart": "rm -rf node_modules package-lock.json && echo \"deleted\" && npm install"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^4.16.2",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "mailgen": "^2.0.34",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "lightningcss": "^1.29.0",
    "prisma": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
